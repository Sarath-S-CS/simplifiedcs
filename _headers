# Netlify response headers (https://docs.netlify.com/routing/headers/).
# scripts/serve.js applies this same file locally, so the CSP below is
# exercised in local preview too, not only once it's live.
#
# Content-Security-Policy, source by source:
#   script-src   'self' serves the app's module files (/assets/build/); no
#                inline scripts, eval, or inline event handlers anywhere, so
#                no 'unsafe-inline'/'unsafe-eval'. static.cloudflareinsights.com
#                is the cookieless Cloudflare Web Analytics beacon (src/head.html).
#   style-src    'unsafe-inline' is required - the UI sets style="" attributes
#                throughout its rendered templates. Google Fonts CSS.
#   font-src     Google Fonts files.
#   img-src      data: for small inline SVG/icons, blob: for the client-side
#                PDF export.
#   connect-src  'self' covers the Netlify functions and the feedback form;
#                Supabase REST for the live News/Exploits/Case Studies feeds;
#                cloudflareinsights.com is where the analytics beacon posts.
#   frame-ancestors 'none' - nothing legitimately frames this site.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://xufqgrcxufptlptpwlfi.supabase.co https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Content-hashed build output (scripts/build.js): a file's name changes
# whenever its content does, so browsers can keep these for a year.
/assets/build/*
  Cache-Control: public, max-age=31536000, immutable
